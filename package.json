{
  "name": "multiframe-calculator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:esbuild": "node scripts/build-esbuild.mjs",
    "preview": "vite preview",
    "test:layout": "node scripts/assert-ceiling-layout.mjs",
    "test": "npm run test:layout && npm run test:plan && npm run test:app-state",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "predev": "npm run prepare:ocr",
    "prebuild": "npm run prepare:ocr",
    "prebuild:esbuild": "npm run prepare:ocr",
    "test:plan": "node --test scripts/plan-import.test.mjs",
    "test:ocr": "npm run prepare:ocr && node scripts/assert-plan-ocr.mjs",
    "test:app-state": "node --test scripts/app-state.test.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "linkedom": "0.18.12",
    "vite": "^5.4.11"
  }
}
